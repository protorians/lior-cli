{
  "$schema": "../../node_modules/@liorian/sdk/schemas/module.schema.json",
  "schemaVersion": 1,
  "id": "hello-world",
  "domain": "mod.liorian.helloworld",
  "key": "HELLO_WORLD",
  "name": "Hello World",
  "description": "Module d'exemple pour l'onboarding des développeurs",
  "version": "1.0.0",
  "icon": "WandSparklesIcon",
  "type": "INTERNAL",
  "entry": "index.tsx",
  "uri": "/hello-world",
  "publisher": {
    "id": "liorian",
    "name": "Liorian Workspace"
  },
  "platforms": {
    "web": {
      "supported": true,
      "modes": ["web"]
    },
    "desktop": {
      "supported": true,
      "modes": ["local-webview"],
      "os": ["windows", "macos", "linux"]
    },
    "mobile": {
      "supported": true,
      "modes": ["local-webview"],
      "os": ["android"],
      "iosSupported": false
    }
  },
  "managerCompatibility": {
    "min": "0.17.1",
    "max": "0.17.x"
  },
  "apiCompatibility": {
    "min": "0.27.0",
    "max": "0.27.x"
  },
  "permissions": ["hello-world.read", "hello-world.write", "hello-world.manage"],
  "apiScopes": ["hello-world.read", "hello-world.write"],
  "capabilities": {
    "needsNetwork": true,
    "supportsOffline": false,
    "requiresOrganization": true,
    "requiresAuthenticatedUser": true
  },
  "isEnabled": true,
  "isDefault": false,
  "requirements": {
    "organization": ">=1.0.0",
    "identity": ">=1.0.0"
  },
  "optionalRequirements": {},
  "widgets": ["analytics"],
  "routines": ["helloWorldAnalyticsRoutine"],
  "providers": ["layout"],
  "menu": {
    "items": [
      {
        "label": "Salutations",
        "icon": "WandSparklesIcon",
        "url": "/hello-world"
      }
    ]
  }
}