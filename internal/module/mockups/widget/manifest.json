{
  "$schema": "../../node_modules/@liorian/sdk/schemas/module.schema.json",
  "schemaVersion": 1,
  "id": "acme-widgets",
  "domain": "widget.liorian.acme-widgets",
  "key": "ACME_WIDGETS",
  "name": "Acme Widgets",
  "description": "Module WIDGET d'exemple : widgets injectés dans la liste du tableau de bord",
  "version": "1.0.0",
  "icon": "LayoutDashboardIcon",
  "type": "WIDGET",
  "external": false,
  "entry": "index.tsx",
  "uri": "/acme-widgets",
  "platforms": {
    "web": {
      "supported": true,
      "modes": ["web"]
    },
    "desktop": {
      "supported": true,
      "modes": ["local-webview"],
      "os": ["windows", "macos", "linux"]
    },
    "mobile": {
      "supported": true,
      "modes": ["local-webview"],
      "os": ["android"]
    }
  },
  "compatibility": {
    "socle": {
      "min": "0.17.1",
      "max": "0.17.x"
    },
    "api": {
      "min": "0.27.0",
      "max": "0.27.x"
    }
  },
  "permissions": [],
  "userScope": [],
  "oauth": {
    "scopes": [
      "openid",
      "profile",
      "email",
      "organizations"
    ]
  },
  "capabilities": [
    "core:default"
  ],
  "isEnabled": true,
  "isDefault": false,
  "requirements": {
    "organization": ">=1.0.0"
  },
  "optionalRequirements": {},
  "widgets": ["acme-widgets.kpi", "acme-widgets.activity"],
  "routines": [],
  "menu": {
    "items": []
  }
}
