{
  "$schema": "lorian.config.schema.json",
  "version": "0.15.0",
  "applications": {
    "liorian-socle": {
      "name": "Lior Socle",
      "description": "Gestion des organisations, utilisateurs, contrôle d'accès, notifications, médiathèque",
      "domains": {
        "production": "socle.liorian.protorians.com",
        "staging": "socle-staging.liorian.protorians.com",
        "development": "localhost:5010"
      },
      "api": {
        "baseUrl": "https://localhost:5711",
        "timeout": 30000
      }
    },
    "liorian-connect": {
      "name": "Liorian Connect",
      "description": "Espace Développeur & Publication de Modules",
      "domains": {
        "production": "connect.liorian.protorians.com",
        "staging": "connect-staging.liorian.protorians.com",
        "development": "localhost:5020"
      },
      "api": {
        "baseUrl": "https://localhost:5711",
        "timeout": 30000
      }
    },
    "liorian-console": {
      "name": "Liorian Console",
      "description": "Administration & gouvernance",
      "domains": {
        "production": "console.liorian.protorians.com",
        "staging": "console-staging.liorian.protorians.com",
        "development": "localhost:5030"
      },
      "api": {
        "baseUrl": "https://localhost:5711",
        "timeout": 30000
      }
    },
    "liorian-store": {
      "name": "Liorian Store",
      "description": "Storefront client pour l'installation de modules",
      "domains": {
        "production": "store.liorian.protorians.com",
        "staging": "store-staging.liorian.protorians.com",
        "development": "localhost:5040"
      },
      "api": {
        "baseUrl": "https://localhost:5731",
        "timeout": 30000
      }
    },
    "liorian-auth": {
      "name": "Liorian Auth",
      "description": "Service d'authentification SSO — Login, consentement OAuth, MFA",
      "domains": {
        "production": "auth.liorian.protorians.com",
        "staging": "auth-staging.liorian.protorians.com",
        "development": "localhost:5050"
      },
      "api": {
        "baseUrl": "https://localhost:5711",
        "timeout": 30000
      },
      "oauth": {
        "authorizationEndpoint": "/oauth/authorize",
        "tokenEndpoint": "/oauth/token",
        "revokeEndpoint": "/oauth/revoke",
        "clientId": "lior-cli",
        "scopes": [
          "openid",
          "profile",
          "email"
        ]
      },
      "mfa": {
        "challengeEndpoint": "/mfa/challenge",
        "totpVerifyEndpoint": "/mfa/totp/verify",
        "recoveryVerifyEndpoint": "/mfa/recovery/verify"
      }
    }
  }
}
