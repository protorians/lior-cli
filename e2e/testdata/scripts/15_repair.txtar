mkdir project
cd project
mkdir -p library/modules
exec sh -c 'printf "app = \"demo\"\n" > lorian.config.toml'
exec $LIORIAN --no-color create module blog-manager --domain mod.liorian.blog-manager --version 1.0.0
exec sh -c 'mkdir -p node_modules/@liorian/sdk node_modules/@tanstack/react-query node_modules/@tanstack/react-table node_modules/date-fns node_modules/lucide-react node_modules/next node_modules/react node_modules/react-dom node_modules/sonner node_modules/@types/node node_modules/@types/react node_modules/@types/react-dom node_modules/typescript'

# Break the manifest: invalid version and missing token (blocking findings).
exec sh -c 'printf "{\n  \"id\": \"blog-manager\",\n  \"domain\": \"mod.liorian.blog-manager\",\n  \"name\": \"Blog Manager\",\n  \"version\": \"not-semver\",\n  \"entry\": \"index.tsx\"\n}\n" > library/modules/mod.liorian.blog-manager/manifest.json'

# TC-038 — `repair` automatically fixes the blocking manifest findings.
exec $LIORIAN --no-color repair mod.liorian.blog-manager
stdout 'Repair: mod.liorian.blog-manager'
stdout 'set version to "0.0.0"'
stdout 'generated a new UUID token'
stdout 'automatic fix\(es\) applied'

# The repaired module has no blocking error left.
exec $LIORIAN --no-color audit mod.liorian.blog-manager
! stderr 'error\(s\)'

# JSON output is machine-usable.
exec $LIORIAN --no-color repair --output json
stdout '"modules"'
stdout '"actions"'

# TC-039 — a complex finding yields manual instructions and a non-zero exit.
exec sh -c 'printf "export const x = 1;\n" > library/modules/mod.liorian.blog-manager/index.tsx'
exec sh -c '$LIORIAN --no-color repair mod.liorian.blog-manager; echo "exit=$?"'
stdout 'Manual actions required'
stdout 'Export the module declaration as default'
stdout 'exit=1'

# TC-040 — the manifest domain no longer has to use the `mod.liorian.` prefix.
exec sh -c 'printf "{\n  \"id\": \"blog-manager\",\n  \"domain\": \"com.example.blog-manager\",\n  \"name\": \"Blog Manager\",\n  \"version\": \"1.0.0\",\n  \"entry\": \"index.tsx\",\n  \"token\": \"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b\"\n}\n" > library/modules/mod.liorian.blog-manager/manifest.json'

# `--no-interaction` renames the module directory to its manifest domain
# without prompting.
exec sh -c '$LIORIAN --no-color repair mod.liorian.blog-manager --no-interaction; echo "exit=$?"'
stdout 'renamed the module directory to "com.example.blog-manager"'
exists library/modules/com.example.blog-manager/manifest.json
! exists library/modules/mod.liorian.blog-manager/manifest.json

# TC-041 — a legacy permission list is migrated to canonical Role:Verbe codes
# without losing the codes the mapping cannot resolve.
mkdir -p library/modules/mod.liorian.perms
exec sh -c 'printf "export default { identifier: \"mod.liorian.perms\", widgets: {} };\n" > library/modules/mod.liorian.perms/index.tsx'
exec sh -c 'printf "{\n  \"id\": \"perms\",\n  \"domain\": \"mod.liorian.perms\",\n  \"name\": \"Perms\",\n  \"version\": \"1.0.0\",\n  \"entry\": \"index.tsx\",\n  \"type\": \"WEB_APP_LOCAL\",\n  \"token\": \"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b\",\n  \"permissions\": [\"user.read\", \"admin.delete\", \"editor.write\"],\n  \"capabilities\": [\"core:default\"]\n}\n" > library/modules/mod.liorian.perms/manifest.json'
exec $LIORIAN --no-color repair mod.liorian.perms --warnings --no-install
# The resolvable codes are migrated...
grep '"User:Get"' library/modules/mod.liorian.perms/manifest.json
grep '"Admin:Delete"' library/modules/mod.liorian.perms/manifest.json
# ...and the ambiguous one is kept, never dropped.
grep '"editor.write"' library/modules/mod.liorian.perms/manifest.json
stdout 'left untouched'

# TC-042 — the platform declaration is completed, never narrowed: a module
# serving desktop keeps doing so.
mkdir -p library/modules/mod.liorian.plat
exec sh -c 'printf "export default { identifier: \"mod.liorian.plat\", widgets: {} };\n" > library/modules/mod.liorian.plat/index.tsx'
exec sh -c 'printf "{\n  \"id\": \"plat\",\n  \"domain\": \"mod.liorian.plat\",\n  \"name\": \"Plat\",\n  \"version\": \"1.0.0\",\n  \"entry\": \"index.tsx\",\n  \"type\": \"WEB_APP_LOCAL\",\n  \"token\": \"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b\",\n  \"permissions\": [],\n  \"capabilities\": [\"core:default\"],\n  \"platforms\": {\n    \"web\": {\"supported\": true},\n    \"desktop\": {\"supported\": true, \"os\": [\"macos\"]},\n    \"mobile\": {\"supported\": false}\n  }\n}\n" > library/modules/mod.liorian.plat/manifest.json'
exec $LIORIAN --no-color repair mod.liorian.plat --warnings --no-install
stdout 'added the missing mode\(s\)'
grep '"desktop"' library/modules/mod.liorian.plat/manifest.json
grep '"local-webview"' library/modules/mod.liorian.plat/manifest.json
grep '"macos"' library/modules/mod.liorian.plat/manifest.json

# TC-043 — a deprecated distribution type is migrated to its canonical value.
mkdir -p library/modules/mod.liorian.legacy-type
exec sh -c 'printf "export default { identifier: \"mod.liorian.legacy-type\", widgets: {} };\n" > library/modules/mod.liorian.legacy-type/index.tsx'
exec sh -c 'printf "{\n  \"id\": \"legacy-type\",\n  \"domain\": \"mod.liorian.legacy-type\",\n  \"name\": \"Legacy Type\",\n  \"version\": \"1.0.0\",\n  \"entry\": \"index.tsx\",\n  \"type\": \"INTERNAL\",\n  \"token\": \"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b\",\n  \"permissions\": [],\n  \"capabilities\": [\"core:default\"]\n}\n" > library/modules/mod.liorian.legacy-type/manifest.json'
exec $LIORIAN --no-color repair mod.liorian.legacy-type --warnings --no-install
stdout 'migrated type "INTERNAL" to "SYSTEM"'
grep '"type": "SYSTEM"' library/modules/mod.liorian.legacy-type/manifest.json

# TC-044 — a legacy reverse-DNS domain is migrated to the canonical
# `mod.<éditeur>.<module>` form, and the module directory follows it.
mkdir -p library/modules/com.example.crm
exec sh -c 'printf "export default { identifier: \"mod.example.crm\", widgets: {} };\n" > library/modules/com.example.crm/index.tsx'
exec sh -c 'printf "{\n  \"id\": \"crm\",\n  \"domain\": \"com.example.crm\",\n  \"name\": \"Crm\",\n  \"version\": \"1.0.0\",\n  \"entry\": \"index.tsx\",\n  \"type\": \"WEB_APP_LOCAL\",\n  \"token\": \"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b\",\n  \"permissions\": [],\n  \"capabilities\": [\"core:default\"]\n}\n" > library/modules/com.example.crm/manifest.json'
exec $LIORIAN --no-color repair com.example.crm --warnings --no-install --no-interaction
stdout 'migrated domain to "mod.example.crm"'
exists library/modules/mod.example.crm/manifest.json
! exists library/modules/com.example.crm/manifest.json
grep '"domain": "mod.example.crm"' library/modules/mod.example.crm/manifest.json

# TC-045 — a CONFIGURATION module is repaired towards its declarative entry,
# never the React one, and its dataModel is reported with guidance.
mkdir -p library/modules/mod.acme.crm
exec sh -c 'printf "{}\n" > library/modules/mod.acme.crm/index.json'
exec sh -c 'printf "{\n  \"id\": \"crm\",\n  \"domain\": \"mod.acme.crm\",\n  \"name\": \"Crm\",\n  \"version\": \"1.0.0\",\n  \"entry\": \"index.tsx\",\n  \"type\": \"CONFIGURATION\",\n  \"token\": \"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b\",\n  \"permissions\": [],\n  \"capabilities\": [\"core:default\"]\n}\n" > library/modules/mod.acme.crm/manifest.json'
exec $LIORIAN --no-color repair mod.acme.crm --warnings --no-install
stdout 'set entry to "index.json"'
grep '"entry": "index.json"' library/modules/mod.acme.crm/manifest.json
stdout 'the CONFIGURATION module declares no dataModel'

# TC-046 — a finding is reported once, not once per pass.
exec sh -c '$LIORIAN --no-color repair mod.liorian.perms --warnings --no-install --output json > report.json'
grep -count=1 'not canonical Role:Verbe' report.json

# TC-047 — a repair never injects the zero value of an absent field: an empty
# publisher block would raise a warning no repair can clear.
! grep '"publisher"' library/modules/mod.liorian.perms/manifest.json
! grep '"isEnabled"' library/modules/mod.liorian.perms/manifest.json
! grep '"menu"' library/modules/mod.liorian.perms/manifest.json

# A second pass has nothing left to do.
exec sh -c '$LIORIAN --no-color repair mod.liorian.perms --warnings --no-install --output json > report2.json'
grep '"actions": null' report2.json
