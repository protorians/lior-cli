mkdir project
cd project
mkdir external_modules
exec sh -c 'printf "app = \"demo\"\n" > lorian.config.toml'
exec $LIORIAN --no-color create module blog-manager --domain mod.liorian.blog-manager --version 1.0.0
exec sh -c 'mkdir -p node_modules/@liorian/sdk node_modules/@tanstack/react-query node_modules/@tanstack/react-table node_modules/date-fns node_modules/lucide-react node_modules/next node_modules/react node_modules/react-dom node_modules/sonner'

# TC-017 — conforming module: audit succeeds, no errors.
exec $LIORIAN --no-color audit mod.liorian.blog-manager
stdout '✓ Audit passed — no errors, no warnings'
stdout 'valid UUID token'

# JSON output (spec §5.10): machine-usable form.
exec $LIORIAN --no-color audit --output json
stdout '"modules"'
stdout '"findings"'

# TC-018 — broken module (no default export): audit errors.
exec sh -c 'printf "export const x = 1;\n" > external_modules/mod.liorian.blog-manager/index.tsx'
exec $LIORIAN --no-color audit mod.liorian.blog-manager
stderr 'Summary: 2 error\(s\)'
stdout 'export not compliant'