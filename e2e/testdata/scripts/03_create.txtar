mkdir project
cd project
mkdir -p library/modules
exec sh -c 'printf "app = \"demo\"\n" > lorian.config.toml'

# TC-003 — invalid identifier: rejected (exit 1) with an explicit message.
! exec $LIORIAN --no-color create module Foo --domain com.example.foo
stderr 'kebab-case'
exec sh -c '"$LIORIAN" --no-color create module Foo --domain com.example.foo >/dev/null 2>&1; echo $?'
stdout '^1$'

# Invalid domain (must be a reverse-DNS dotted form): rejected.
! exec $LIORIAN --no-color create module blog-manager --domain blog-manager
stderr 'reverse-DNS'

# TC-004 — valid name + domain: complete structure scaffolded from the
# embedded mockup under library/modules/<domain>.
exec $LIORIAN --no-color create module blog-manager --domain com.example.blog-manager --version 1.0.0
stdout 'Module created'
stdout 'Token generated'
stdout 'manifest.json initialized'
stdout 'index.tsx initialized'
stdout 'Page created from mockup'
stdout 'Required modules verified'
stdout 'Dependencies resolved'

cd library/modules/com.example.blog-manager
exists manifest.json
exists index.tsx
exists README.md
exists package.json
exists application
exists domain
exists infrastructure
exists presentation
exec grep -q '"version": "1.0.0"' manifest.json
exec grep -q '"name": "Blog Manager"' manifest.json
exec grep -q '"id": "blog-manager"' manifest.json
exec grep -q '"domain": "com.example.blog-manager"' manifest.json
exec grep -q '"token": "[0-9a-f-]*"' manifest.json
exec grep -q '"dependencies"' package.json
! exec grep -q '"dependencies"' manifest.json
exec grep -q '"$schema"' manifest.json
exec grep -q '"optionalRequirements": {}' manifest.json
exec grep -q '"platforms"' manifest.json
exec grep -q '"compatibility"' manifest.json
exec grep -q '"oauth"' manifest.json
exec grep -q '"capabilities"' manifest.json
exec grep -q '"type": "WEB_APP_LOCAL"' manifest.json
exec grep -q '"category": "SYSTEM"' manifest.json

# The manifest is the single source of truth: no dependencies in index.tsx.
! exec grep -q 'dependencies:' index.tsx

# The declaration declares a uri → the page is scaffolded in src/app.
cd ../../../src/app/blog-manager
exists page.tsx

# TC-004b — `create view` scaffolds a presentation view inside the module.
cd ../../../library/modules/com.example.blog-manager
exec $LIORIAN --no-color create view com.example.blog-manager user-profile --label 'User Profile' --description 'Profil utilisateur'
stdout 'View created'
stdout 'Exported component: UserProfile'
exists presentation/views/user-profile.view.tsx
exec grep -q 'export function UserProfileView()' presentation/views/user-profile.view.tsx
exec grep -q 'label="User Profile"' presentation/views/user-profile.view.tsx

# TC-004c — an existing view cannot be created twice.
! exec $LIORIAN --no-color create view com.example.blog-manager user-profile --name user-profile
stderr 'already exists'
