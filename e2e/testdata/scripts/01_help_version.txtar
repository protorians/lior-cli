# TC-019 — `liorian help` without arguments prints the general help.
exec $LIORIAN --no-color help
stdout 'Liorian CLI is the one development tool'
stdout 'Available Commands:'
stdout '  pack '

# TC-020 — `liorian help` with a command prints that command's help.
exec $LIORIAN --no-color help pack
stdout 'Builds a module'
stdout 'Usage:'
stdout '  liorian pack \[<module>\[@<version>\]\] \[flags\]'

# TC-021 — `liorian -v` / `--version` affiche la version.
exec $LIORIAN --no-color -v
stdout '^liorian vdev'
exec $LIORIAN --no-color --version
stdout '^liorian vdev'