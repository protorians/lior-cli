mkdir project
cd project
mkdir external_modules
exec sh -c 'printf "app = \"demo\"\n" > lorian.config.toml'
exec $LIORIAN --no-color create module blog-manager --domain com.example.blog-manager --version 1.0.0
exec sh -c 'mkdir -p public/assets/com.example.blog-manager'
exec sh -c 'echo "logo" > public/assets/com.example.blog-manager/logo.txt'
exec sh -c 'mkdir -p src/app/blog-manager'
exec sh -c 'echo "page" > src/app/blog-manager/page.tsx'

# TC-009 — `pack` of an existing module, produces the .SenMod archive.
exec $LIORIAN --no-color pack com.example.blog-manager
stdout '✓ Archive created successfully'
stdout 'Module : com.example.blog-manager v1.0.0'
exists .lorian/build/com.example.blog-manager-1.0.0.SenMod

# TC-010 — the archive contains the module manifest, app sources and assets.
exec sh -c 'unzip -l .lorian/build/com.example.blog-manager-1.0.0.SenMod | grep -q "external_modules/com.example.blog-manager/manifest.json"'
exec sh -c 'unzip -l .lorian/build/com.example.blog-manager-1.0.0.SenMod | grep -q "src/app/blog-manager/page.tsx"'
exec sh -c 'unzip -l .lorian/build/com.example.blog-manager-1.0.0.SenMod | grep -q "public/assets/com.example.blog-manager/logo.txt"'

# Missing module: exit 3 (ExitModuleNotFound).
! exec $LIORIAN --no-color pack com.example.missing
stderr 'does not exist in external_modules'
exec sh -c '"$LIORIAN" --no-color pack com.example.missing >/dev/null 2>&1; echo $?'
stdout '^3$'

# TC-011 — `pack <module>@<version>` builds a specific version.
exec $LIORIAN --no-color pack com.example.blog-manager@2.1.0
stdout '✓ Archive created successfully'
stdout 'Module : com.example.blog-manager v2.1.0'
exists .lorian/build/com.example.blog-manager-2.1.0.SenMod
exec sh -c 'test -f .lorian/build/com.example.blog-manager-2.1.0.SenMod'

# Invalid version: rejected before building.
! exec $LIORIAN --no-color pack com.example.blog-manager@not-a-version
stderr 'invalid version'