# §2.4 Future Scope — `marketplace` against the public catalog
# (mock `/api/catalog/*` + artifacts of the developer-store).

# TC-030 — `marketplace search` lists the seeded catalog modules.
exec $LIORIAN --no-color marketplace search
stderr 'Searching the catalog'
stdout '3 result\(s\)'
stdout 'com.example.blog-manager'
stdout 'com.analytics.visitors'
stdout 'protorians'

# Full-text query narrows the results.
exec $LIORIAN --no-color marketplace search visitors
stdout '1 result\(s\)'
stdout 'com.analytics.visitors'

# Category filter (matched against PRIMARY/SECONDARY category).
exec $LIORIAN --no-color marketplace search --category DATA
stdout 'com.analytics.visitors'

# An unmatched search is a neutral empty result, not an error.
exec $LIORIAN --no-color marketplace search nonexistent-module
stdout 'No module matches your search.'

# TC-031 — unsigned artefacts are refused fail-closed (SEC-001, ADR-010).
mkdir project
cd project
exec sh -c 'printf "app = \"demo\"\n" > lorian.config.toml'
mkdir -p library/modules
! exec $LIORIAN --no-color marketplace install com.analytics.visitors
stderr 'not signed'
stderr 'signature is mandatory'

# --allow-unsigned is the explicit dev escape hatch.
exec $LIORIAN --no-color marketplace install com.analytics.visitors --allow-unsigned
stderr 'Installing com.analytics.visitors'
stderr 'archive not signed'
stdout '✓ Module installed'
stdout 'Module : com.analytics.visitors v0.4.1'
stdout 'Signature : not signed'
# D11: the module lands multi-version with the current pointer.
grep '"id": "com.analytics.visitors"' library/modules/com.analytics.visitors/0.4.1/manifest.json
exec test -f library/modules/com.analytics.visitors/0.4.1/src/entry.tsx
exec test -f library/modules/com.analytics.visitors/0.4.1/artifact/module.js
exec sh -c 'test "$(cat library/modules/com.analytics.visitors/current)" = "0.4.1"'

# Re-installing the same version is refused (exit 3) with a fix hint.
exec sh -c '$LIORIAN --no-color marketplace install com.analytics.visitors --allow-unsigned; echo "exit=$?"'
stderr 'already installed'
stdout 'exit=3'

# --force replaces the version directory.
exec sh -c 'printf "stale" > library/modules/com.analytics.visitors/0.4.1/marker.txt'
exec $LIORIAN --no-color marketplace install com.analytics.visitors --force --allow-unsigned
stdout '✓ Module installed'
! exec test -f library/modules/com.analytics.visitors/0.4.1/marker.txt

# TC-032 — a signed module verifies its Ed25519 signature during install.
exec $LIORIAN --no-color marketplace install com.example.blog-manager
stdout '✓ Module installed'
stdout 'Module : com.example.blog-manager v1.2.0'
stdout 'Signature : ✓ Signature verified'
grep '"version": "1.2.0"' library/modules/com.example.blog-manager/1.2.0/manifest.json
exec sh -c 'test "$(cat library/modules/com.example.blog-manager/current)" = "1.2.0"' 

# A module whose catalog checksum does not match its artifact is refused.
! exec $LIORIAN --no-color marketplace install com.example.corrupted
stderr 'SHA-256 checksum mismatch'
stderr 'retry the installation'

# An unknown module is a not-found error (exit 3).
exec sh -c '$LIORIAN --no-color marketplace install com.unknown.module; echo "exit=$?"'
stdout 'exit=3'
stderr 'failed to fetch module'

# Install outside a workspace requires a project root.
cd ..
! exec $LIORIAN --no-color marketplace install com.example.blog-manager
stderr 'no Liora project found'