# TC-005 / TC-007 / TC-008 / TC-011 / TC-012 — full network flow against the
# liorian-auth mock (LIORIAN_AUTH_API).
mkdir project
cd project
mkdir external_modules
exec sh -c 'printf "{\"publish\":{\"autoAudit\":false}}\n" > lorian.config.json'
exec $LIORIAN --no-color create module blog-manager --domain com.example.blog-manager --version 1.0.0

# TC-007 — wrong credentials: explicit failure (exit 2 / ExitAuth).
env LIORIAN_CLI_CONNECT_EMAIL=invalid@example.com
env LIORIAN_CLI_CONNECT_PASSWORD=wrong
! exec $LIORIAN --no-color connect
stderr 'Invalid credentials'
exec sh -c '"$LIORIAN" --no-color connect >/dev/null 2>&1; echo $?'
stdout '^2$'

# TC-005 — connect without MFA: session persisted.
env LIORIAN_CLI_CONNECT_EMAIL=dev@example.com
env LIORIAN_CLI_CONNECT_PASSWORD=secret
exec $LIORIAN --no-color connect
stdout '✓ Connected as dev@example.com'
exists $HOME/.lorian-cli/credentials.enc

# TC-008 — disconnect (auto-confirm LIORIAN_CLI_YES): credentials removed.
env LIORIAN_CLI_YES=1
exec $LIORIAN --no-color disconnect
stdout '✓ Disconnected successfully'
! exec test -e /.lorian-cli/credentials.enc

# TC-011 — publish while disconnected: the command auto-runs `liorian connect`
# first (spec §5.6 step 1), then publishes. The env-driven sign-in below feeds
# the auto-connect flow against the mock API.
env LIORIAN_CLI_CONNECT_EMAIL=dev@example.com
env LIORIAN_CLI_CONNECT_PASSWORD=secret
exec $LIORIAN --no-color publish com.example.blog-manager
stdout '✓ Connected as dev@example.com'
stdout '✓ Published successfully'
stdout 'URL : https://store.liorian.dev/modules/blog-manager'
exec grep -q '"token": "[0-9a-f-]' external_modules/com.example.blog-manager/manifest.json

# TC-012 — same version already published: 409 conflict (exit 11 / ExitPublish).
! exec $LIORIAN --no-color publish com.example.blog-manager
stderr 'An identical version already exists'
exec sh -c '"$LIORIAN" --no-color publish com.example.blog-manager >/dev/null 2>&1; echo $?'
stdout '^11$'